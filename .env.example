# xposed — Environment Variables

# OpenAI API Key (REQUIRED for real AI roasts, works without it using mock data)
OPENAI_API_KEY=

# OpenAI Model (optional, default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Supabase URL + Anon Key (optional, for storing top users leaderboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
